{
  "publish": {
    "privacy_level": "PUBLIC_TO_EVERYONE",
    "allow_comment": true,
    "allow_duet": false,
    "allow_stitch": false,
    "is_aigc": false
  },
  "title_max_length": 150,
  "description_max_length": 4000,
  "images_per_post": 1,
  "avoid_repeat_theme_within_posts": 4,
  "avoid_repeat_image_within_posts": 5,
  "avoid_repeat_movie_within_posts": 3,
  "movies_per_post": 10,
  "location_text": null,
  "music": {
    "enabled": true,
    "country_code": "US",
    "date_range": "7DAY",
    "avoid_repeat_track_within_posts": 3,
    "genre_by_font_style": {
      "default": "ALL",
      "romance": "LO-FI",
      "horror": "EPIC",
      "drama": "EPIC",
      "comedy": "POP",
      "anime": "K-POP",
      "scifi": "EDM"
    }
  },
  "fonts": {
    "fallback_font": "DejaVuSans-Bold.ttf",
    "body_font": "Montserrat-Bold.ttf",
    "body_font_size": 50,
    "headline_styles": {
      "default": { "file": "Oswald-Regular.ttf", "size": 68 },
      "romance": { "file": "BadScript-Regular.ttf", "size": 88 },
      "horror": { "file": "RubikBurned-Regular.ttf", "size": 60 },
      "drama": { "file": "YesevaOne-Regular.ttf", "size": 62 },
      "comedy": { "file": "RubikBubbles-Regular.ttf", "size": 56 },
      "anime": { "file": "RubikGlitch-Regular.ttf", "size": 58 },
      "scifi": { "file": "Unbounded-ExtraBold.ttf", "size": 52 }
    }
  }
}
